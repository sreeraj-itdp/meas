    "import os\n",
    "# Fetch environmental variable\n",
    "env = os.getenv(\"ENVIRONMENT\")\n",
    "appid = os.getenv(\"APPID\")\n",
    "adb_scope = \"meas-\"+env+\"-wu-kv-01-scp\"\n",
    "# Handle gcp env because we've dev/qa/prod\n",
    "if env in ('dev','qa1'):\n",
    "    gcpenv = 'qa'\n",
    "else:\n",
    "    gcpenv =  env"
   ]
